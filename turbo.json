{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["VITEST"],
  "globalDependencies": ["skills/SKILL.md", "scripts/copy-agent-skill.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "outputLogs": "errors-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "check:exports": {
      "dependsOn": ["build"],
      "outputLogs": "errors-only"
    },
    "check": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "//#lint:spell": {
      "outputLogs": "errors-only"
    },
    "//#lint:knip": {
      "outputLogs": "errors-only"
    },
    "//#lint:repo": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "clean": {
      "cache": false
    },
    "@santi020k/astro-doctor#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/action.yml",
        "$TURBO_ROOT$/.github/workflows/*.yml",
        "$TURBO_ROOT$/scripts/check-validated-commit.sh"
      ]
    },
    "@santi020k/astro-doctor#test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/action.yml",
        "$TURBO_ROOT$/.github/workflows/*.yml",
        "$TURBO_ROOT$/scripts/check-validated-commit.sh"
      ]
    }
  },
  "futureFlags": {
    "errorsOnlyShowHash": true
  }
}
