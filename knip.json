{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    "apps/docs": {
      "entry": ["src/pages/**/*.{astro,ts}", "scripts/*.mjs", "og.audit.config.mjs"],
      "project": ["src/**/*.{astro,ts,css}", "scripts/*.mjs"]
    },
    "packages/eslint-plugin-astro-doctor": {
      "ignoreDependencies": ["@arethetypeswrong/cli"],
      "project": ["src/**/*.ts"]
    },
    "packages/astro-doctor": {
      "entry": ["bin/**/*.ts", "src/cli.ts"],
      "ignoreDependencies": ["@arethetypeswrong/cli"],
      "project": ["src/**/*.ts", "bin/**/*.ts"]
    },
    "packages/vscode-astro-doctor": {

      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@santi020k/astro-doctor", "@santi020k/eslint-plugin-astro-doctor", "@types/vscode"]
    }
  }
}
