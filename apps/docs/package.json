{
  "name": "@santi020k/astro-doctor-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation website for astro-doctor",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "astro dev",
    "build": "santi-og generate --config scripts/generate-og-images.mjs && astro build",
    "postbuild": "santi-og audit",
    "generate:og": "santi-og generate --config scripts/generate-og-images.mjs",
    "generate:og:force": "santi-og generate --config scripts/generate-og-images.mjs --force",
    "check:og": "santi-og check --config scripts/generate-og-images.mjs",
    "audit:seo": "santi-og audit",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "clean": "rm -rf dist .astro node_modules",
    "test:browser": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "catalog:",
    "@santi020k/lumen-astro": "^4.0.0",
    "@santi020k/lumen-core": "^4.0.0",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@santi020k/eslint-config-basic": "catalog:",
    "@santi020k/og": "1.2.0",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  }
}
