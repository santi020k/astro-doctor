---
import GitHubIcon from '@/components/github-icon.astro'
import LogoMark from '@/components/logo-mark.astro'

import { ButtonLink, Link, NavigationMenu, ThemeToggle } from '@santi020k/lumen-astro'

import { GITHUB_URL, NPM_URL, SITE_NAME } from '@/site.config'

const currentPath = Astro.url.pathname.replace(/\/$/, '')
const isRulesActive = currentPath === '/docs/rules' || currentPath.startsWith('/docs/rules/')
const isCliActive = currentPath === '/docs/cli' || currentPath.startsWith('/docs/cli/')
const isDocsActive = currentPath.startsWith('/docs') && !isRulesActive && !isCliActive
---

<header class="
  sticky top-0 z-50 w-full border-b border-[hsl(var(--line)/0.4)]
  bg-[hsl(var(--theme-bg)/0.85)] backdrop-blur-md
"
>
  <div class="
    site-navigation container-docs flex h-14 items-center justify-between gap-4
  "
  >
    <!-- Logo -->
    <Link
href="/"
class="
  group flex items-center gap-2.5 no-underline
  hover:no-underline
"
    >
      <LogoMark
        class="
          size-8 rounded-lg shadow-md transition-shadow
          group-hover:shadow-[0_0_16px_hsl(var(--brand)/0.5)]
        "
      />
      <span class="font-semibold tracking-tight text-[hsl(var(--ink))]">
        {SITE_NAME}
      </span>
    </Link>

    <!-- Desktop nav -->
    <NavigationMenu
      aria-label="Primary"
      class="site-primary-navigation items-center gap-1"
    >
      <Link
        href="/docs"
        aria-current={isDocsActive ? 'page' : undefined}
        class:list={[
          'rounded-md px-3 py-1.5 text-sm transition-colors',
          isDocsActive ?
            'bg-[hsl(var(--brand-soft))] font-medium text-[hsl(var(--brand))]' :
            `
              text-[hsl(var(--ink-soft))]
              hover:bg-[hsl(var(--surface-muted))] hover:text-[hsl(var(--ink))]
            `
        ]}
      >
        Docs
      </Link>
      <Link
        href="/docs/rules"
        aria-current={isRulesActive ? 'page' : undefined}
        class:list={[
          'rounded-md px-3 py-1.5 text-sm transition-colors',
          isRulesActive ?
            'bg-[hsl(var(--brand-soft))] font-medium text-[hsl(var(--brand))]' :
            `
              text-[hsl(var(--ink-soft))]
              hover:bg-[hsl(var(--surface-muted))] hover:text-[hsl(var(--ink))]
            `
        ]}
      >
        Rules
      </Link>
      <Link
        href="/docs/cli"
        aria-current={isCliActive ? 'page' : undefined}
        class:list={[
          'rounded-md px-3 py-1.5 text-sm transition-colors',
          isCliActive ?
            'bg-[hsl(var(--brand-soft))] font-medium text-[hsl(var(--brand))]' :
            `
              text-[hsl(var(--ink-soft))]
              hover:bg-[hsl(var(--surface-muted))] hover:text-[hsl(var(--ink))]
            `
        ]}
      >
        CLI
      </Link>
    </NavigationMenu>

    <!-- Right side actions -->
    <div class="flex items-center gap-2">
      <!-- Theme toggle -->
      <ThemeToggle
        aria-label="Toggle color scheme"
        data-ui-controlled
        class="
          site-theme-toggle flex size-8 items-center justify-center rounded-md
          text-[hsl(var(--ink-soft))] transition-colors
          hover:bg-[hsl(var(--surface-muted))] hover:text-[hsl(var(--ink))]
        "
      />

      <!-- GitHub link -->
      <ButtonLink
        href={GITHUB_URL}
        newTab
        ariaLabel="View on GitHub"
        shape="icon"
        variant="ghost"
        class="
          site-icon-link flex size-8 items-center justify-center rounded-md
          text-[hsl(var(--ink-soft))] transition-colors
          hover:bg-[hsl(var(--surface-muted))] hover:text-[hsl(var(--ink))]
        "
      >
        <GitHubIcon />
      </ButtonLink>

      <ButtonLink
        href={NPM_URL}
        newTab
        variant="primary"
        class="
          site-npm-link hidden h-8 items-center gap-1.5 rounded-md
          bg-[hsl(var(--brand))] px-3 text-xs font-semibold text-white
          no-underline transition-colors
          hover:bg-[hsl(var(--brand-solid))]
          sm:flex
        "
      >
        npm package
      </ButtonLink>
    </div>
  </div>
</header>

<style>
  :global(.site-primary-navigation.ui-navigation-menu) {
    display: none;
    width: auto;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
  }

  @media (min-width: 48rem) {
    :global(.site-primary-navigation.ui-navigation-menu) {
      display: flex;
    }
  }

  :global(.site-navigation .ui-link) {
    font-weight: inherit;
  }

  :global(.site-navigation .site-theme-toggle.ui-theme-toggle) {
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    box-shadow: none;
  }

  :global(.site-navigation .site-theme-toggle.ui-theme-toggle::before) {
    display: none;
  }

  :global(.site-navigation .site-theme-toggle.ui-theme-toggle:hover) {
    transform: none;
    background: hsl(var(--surface-muted));
    color: hsl(var(--ink));
    box-shadow: none;
  }

  :global(.site-navigation .site-theme-toggle .ui-theme-toggle__sun),
  :global(.site-navigation .site-theme-toggle .ui-theme-toggle__moon) {
    width: 1rem;
    height: 1rem;
    margin-top: -0.5rem;
    margin-left: -0.5rem;
  }

  :global(.site-navigation .site-icon-link.ui-button-link--icon) {
    width: 2rem;
    height: 2rem;
    min-height: 2rem;
    border: 0;
    border-radius: 0.375rem;
    padding: 0;
  }

  :global(.site-navigation .site-npm-link.ui-button-link) {
    display: none;
    min-height: 2rem;
    border: 0;
    border-radius: 0.375rem;
    padding: 0 0.75rem;
  }

  @media (min-width: 40rem) {
    :global(.site-navigation .site-npm-link.ui-button-link) {
      display: flex;
    }
  }
</style>

<script>
  import { transitionColorTheme } from '@/utils/transition-color-theme'

  const html = document.documentElement
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-ui-theme-toggle]')

  const getTheme = () => html.getAttribute('data-theme') ??
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')

  const applyTheme = (theme: string) => {
    html.setAttribute('data-theme', theme)

    localStorage.setItem('theme', theme)
  }

  applyTheme(localStorage.getItem('theme') ?? getTheme())

  themeToggle?.addEventListener('click', () => {
    const nextTheme = getTheme() === 'dark' ? 'light' : 'dark'

    transitionColorTheme(themeToggle, () => applyTheme(nextTheme))
  })
</script>
