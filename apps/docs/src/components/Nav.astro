---
import DocsSidebar from '@/components/DocsSidebar.astro'
import GitHubIcon from '@/components/github-icon.astro'
import LogoMark from '@/components/logo-mark.astro'

import { Button, ButtonLink, Icon, Link, NavigationMenu, Sheet, ThemeToggle } from '@santi020k/lumen-astro'

import { GITHUB_URL, SITE_NAME } from '@/site.config'

interface Props {
  variant?: 'dock' | 'signature'
}

const { variant = 'dock' } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')
const isRulesActive = currentPath === '/docs/rules' || currentPath.startsWith('/docs/rules/')
const isCliActive = currentPath === '/docs/cli' || currentPath.startsWith('/docs/cli/')

const navigationItems = [
  { label: 'Documentation', href: '/docs', active: currentPath.startsWith('/docs') && !isRulesActive && !isCliActive },
  { label: 'Rules', href: '/docs/rules', active: isRulesActive },
  { label: 'CLI', href: '/docs/cli', active: isCliActive }
]
---

<header class="site-header" data-header-variant={variant}>
  <div class="container-docs">
    <div class="site-header-shell" data-header-shell data-scrolled="false">
      <Link href="/" variant="inherit" class="site-header-brand" aria-label={`${SITE_NAME} home`}>
        <LogoMark class="site-header-mark" />
        <span class="site-header-brand-name">Astro<span> Doctor</span><span class="
          site-header-period
        "
                                                                      >.</span></span>
      </Link>

      <NavigationMenu
variant="unstyled"
aria-label="Primary"
class="site-primary-navigation"
      >
        {navigationItems.map(item => (
          <Link
href={item.href}
variant="inherit"
aria-current={item.active ? 'page' : undefined}
class="site-navigation-link"
          >
            {item.label}
          </Link>
        ))}
      </NavigationMenu>

      <div class="site-header-actions">
        <ThemeToggle
controlled
aria-label="Dark color theme"
class="site-theme-toggle"
data-site-theme-toggle
        />
        <ButtonLink
href={GITHUB_URL}
newTab
ariaLabel="Astro Doctor on GitHub"
variant="unstyled"
class="site-github-link"
        >
          <GitHubIcon />
        </ButtonLink>
        <ButtonLink
href="/docs/quick-start"
variant="unstyled"
class="site-start-link"
        >
          <span>Get started</span><span class="site-action-arrow"><Icon name="arrow-up-right" /></span>
        </ButtonLink>
        <Button
          variant="ghost"
          class="site-menu-trigger"
          aria-label="Open navigation"
          aria-controls="site-navigation-panel"
          data-ui-sheet-trigger="site-navigation-panel"
        >
          <Icon name="menu" />
        </Button>
      </div>
    </div>
  </div>
</header>

<noscript>
  <style is:inline>
    .site-menu-trigger, .site-theme-toggle { display: none; }
  </style>
  <div class="container-docs site-no-script-navigation">
    <NavigationMenu variant="unstyled" aria-label="Primary">
      {navigationItems.map(item => <Link href={item.href} variant="inherit">{item.label}</Link>)}
    </NavigationMenu>
  </div>
</noscript>

<Sheet id="site-navigation-panel" class="site-navigation-panel" aria-labelledby="site-navigation-title">
  <div class="site-menu-heading">
    <div>
      <span class="site-eyebrow">Astro Doctor</span>
      <h2 id="site-navigation-title">Explore the docs<span>.</span></h2>
    </div>
    <Button variant="ghost" class="site-menu-close" aria-label="Close navigation" data-ui-sheet-close>
      <Icon name="x" />
    </Button>
  </div>
  <nav class="site-mobile-primary" aria-label="Main navigation">
    <Link href="/" variant="inherit">Home<Icon name="arrow-up-right" /></Link>
    <Link href="/docs/quick-start" variant="inherit">Start your first scan<Icon name="arrow-up-right" /></Link>
  </nav>
  <DocsSidebar placement="menu" />
  <Link href={GITHUB_URL} newTab variant="inherit" class="site-menu-source">View the source on GitHub <Icon name="arrow-up-right" /></Link>
</Sheet>

<script>
  import { SITE_HEADER_SCROLL_THRESHOLD_PX } from '@/constants'

import { runLumenViewTransition } from '@santi020k/lumen-core'

  let navigationController: AbortController | undefined

  const initializeNavigation = (): void => {
    navigationController?.abort()

    navigationController = new AbortController()

    const { signal } = navigationController
    const header = document.querySelector<HTMLElement>('[data-header-shell]')
    const headerRegion = document.querySelector<HTMLElement>('.site-header')
    const themeToggle = document.querySelector<HTMLButtonElement>('[data-site-theme-toggle]')
    const navigationPanel = document.querySelector<HTMLDialogElement>('#site-navigation-panel')
    const desktopQuery = window.matchMedia('(min-width: 64rem)')

    const updateHeader = (): void => {
      if (header) header.dataset.scrolled = String(window.scrollY > SITE_HEADER_SCROLL_THRESHOLD_PX)
    }

    const updateThemeControl = (): void => {
      const isDark = document.documentElement.dataset.theme === 'dark'

      themeToggle?.setAttribute('title', isDark ? 'Switch to light theme' : 'Switch to dark theme')

      themeToggle?.setAttribute('aria-pressed', String(isDark))

      if (themeToggle) themeToggle.dataset.uiTheme = isDark ? 'dark' : 'light'
    }

    themeToggle?.addEventListener('click', () => {
      void runLumenViewTransition(document, () => {
      const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'

      document.documentElement.dataset.theme = nextTheme

      updateThemeControl()

      try {
        localStorage.setItem('theme', nextTheme)
      } catch {
        document.documentElement.dataset.theme = nextTheme
      }
    })
    }, { signal })

    desktopQuery.addEventListener('change', () => {
      if (desktopQuery.matches) navigationPanel?.close()
    }, { signal })

    if (headerRegion) {
      const headerObserver = new ResizeObserver(() => {
        document.documentElement.style.setProperty('--site-header-height', `${Math.ceil(headerRegion.offsetHeight)}px`)
      })

      headerObserver.observe(headerRegion)

      signal.addEventListener('abort', () => headerObserver.disconnect(), { once: true })
    }

    window.addEventListener('scroll', updateHeader, { passive: true, signal })

    updateHeader()

    updateThemeControl()
  }

  document.addEventListener('astro:before-swap', event => {
    event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme

    document.querySelector<HTMLDialogElement>('#site-navigation-panel')?.close()

    navigationController?.abort()
  })

  document.addEventListener('astro:page-load', initializeNavigation)

  initializeNavigation()
</script>
