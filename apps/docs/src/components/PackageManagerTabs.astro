---
import { CodeTabs } from '@santi020k/lumen-astro'

interface Props {
  pnpm?: string
  npm?: string
  yarn?: string
  bun?: string
}

interface PackageManagerTab {
  code: string
  label: string
  language: string
  value: string
}

const { pnpm, npm, yarn, bun } = Astro.props

const tabs = [
  { code: pnpm, label: 'pnpm', language: 'bash', value: 'pnpm' },
  { code: npm, label: 'npm', language: 'bash', value: 'npm' },
  { code: yarn, label: 'yarn', language: 'bash', value: 'yarn' },
  { code: bun, label: 'bun', language: 'bash', value: 'bun' }
].filter((tabDefinition): tabDefinition is PackageManagerTab => Boolean(tabDefinition.code))
---

<CodeTabs
  ariaLabel="Package manager"
  class="pm-tabs"
  items={tabs}
  storageKey="astro-doctor-preferred-pm"
/>

<style is:global>
  .pm-tabs.ui-code-tabs {
    margin: 1.25rem 0;
  }
</style>
