---
import type { ComponentProps } from 'astro/types'

import { Code as HighlightedCode } from 'astro:components'

import { Code } from '@santi020k/lumen-astro'

interface Props {
  class?: string
  code: string
  copy?: boolean
  label?: string
  language?: ComponentProps<typeof HighlightedCode>['lang']
  theme?: 'auto'
  variant?: 'block'
  wrap?: boolean
}

const {
  class: className,
  code,
  copy = true,
  label,
  language = 'text',
  theme = 'auto',
  variant = 'block',
  wrap = true
} = Astro.props

const languageLabel = typeof language === 'string' ? language : language.name

const blockClassName = [
  'docs-code-block',
  wrap && 'ui-code--wrap',
  className
].filter(Boolean).join(' ')

const themes = {
  dark: 'catppuccin-mocha',
  light: 'catppuccin-latte'
} satisfies NonNullable<ComponentProps<typeof HighlightedCode>['themes']>
---

<Code
  class={blockClassName}
  copy={copy}
  highlighted
  label={label}
  language={languageLabel}
  theme={theme}
  variant={variant}
>
  <HighlightedCode
    code={code}
    defaultColor={false}
    lang={language}
    themes={themes}
  />
</Code>

<style>
  :global(.docs-code-block) {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  :global(.docs-code-block.ui-code--wrap pre) {
    overflow-x: hidden;
  }

  :global(.docs-code-block.ui-code--wrap code) {
    min-width: 0;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
</style>
