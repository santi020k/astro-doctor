---
import type { CodeLanguage } from 'astro'

import { Code as HighlightedCode } from 'astro:components'

import { Code } from '@santi020k/lumen-astro'

interface Props {
  class?: string
  code: string
  copy?: boolean
  label?: string
  language?: CodeLanguage
  theme?: 'auto'
  variant?: 'block'
  wrap?: boolean
}

const {
  class: className,
  code,
  copy = true,
  label,
  language = 'text',
  theme = 'auto',
  variant = 'block',
  wrap = true
} = Astro.props

const languageLabel = typeof language === 'string' ? language : language.name

const themes: Record<'dark' | 'light', 'catppuccin-mocha' | 'github-light-high-contrast'> = {
  dark: 'catppuccin-mocha',
  light: 'github-light-high-contrast'
}
---

<Code
  class={className}
  code={code}
  codeLabel={label ?? `${languageLabel} example`}
  copy={copy}
  highlighted
  label={label}
  language={languageLabel}
  theme={theme}
  variant={variant}
  wrap={wrap}
>
  <HighlightedCode
    code={code}
    defaultColor={false}
    lang={language}
    themes={themes}
  />
</Code>
