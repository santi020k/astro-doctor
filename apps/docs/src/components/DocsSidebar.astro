---
import { Badge, Link, Sidebar } from '@santi020k/lumen-astro'

import { DOCS_NAV } from '@/data/nav'

interface Props {
  placement?: 'rail' | 'menu'
}

const { placement = 'rail' } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')
---

<Sidebar
variant="unstyled"
class:list={['docs-sidebar', { 'docs-sidebar-rail': placement === 'rail', 'docs-sidebar-menu': placement === 'menu' }]}
>
  <nav class="docs-sidebar-navigation" aria-label="Documentation">
    {DOCS_NAV.map((section, index) => (
      <div class="docs-sidebar-section">
        <h2 class="docs-sidebar-heading"><span aria-hidden="true">0{index + 1}</span>{section.title}</h2>
        <ul>
          {section.items.map(item => {
            const isActive = currentPath === item.href || currentPath === item.href + '/index'

            return (
              <li>
                <Link
href={item.href}
variant="inherit"
class="docs-sidebar-link"
aria-current={isActive ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                  {item.badge && (
<Badge
variant="secondary"
class="docs-sidebar-badge"
>{item.badge}</Badge>
)}
                </Link>
              </li>
            )
          })}
        </ul>
      </div>
    ))}
  </nav>
</Sidebar>
