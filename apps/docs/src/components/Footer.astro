---
import LogoMark from '@/components/logo-mark.astro'

import { Link } from '@santi020k/lumen-astro'

import { AUTHOR, AUTHOR_URL, CHANGELOG_URL, GITHUB_URL, NPM_URL, REACT_DOCTOR_URL, SITE_NAME, SITE_TAGLINE } from '@/site.config'

const year = new Date().getFullYear()
---

<footer class="site-footer mt-24 border-t border-[hsl(var(--line)/0.4)] py-12">
  <div class="container-docs">
    <div class="
      flex flex-col gap-8
      sm:flex-row sm:justify-between
    "
    >
      <!-- Brand -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2.5">
          <LogoMark class="size-7 rounded-md" />
          <span class="font-semibold text-[hsl(var(--ink))]">{SITE_NAME}</span>
        </div>
        <p class="max-w-xs text-sm text-[hsl(var(--ink-muted))]">
          {SITE_TAGLINE}
        </p>
        <p class="text-xs text-[hsl(var(--ink-muted))]">
          Inspired by <Link
href={REACT_DOCTOR_URL}
target="_blank"
rel="noopener noreferrer"
class="
  transition-colors
  hover:text-[hsl(var(--brand))]
"
                      >react-doctor</Link>
        </p>
      </div>

      <!-- Links -->
      <div class="
        grid grid-cols-2 gap-8
        sm:grid-cols-3
      "
      >
        <div class="flex flex-col gap-2">
          <h3 class="
            text-xs font-semibold tracking-wider text-[hsl(var(--ink-muted))]
            uppercase
          "
          >Docs</h3>
          <Link
href="/docs"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >Introduction</Link>
          <Link
href="/docs/installation"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >Installation</Link>
          <Link
href="/docs/quick-start"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >Quick Start</Link>
          <Link
href="/docs/configuration"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >Configuration</Link>
        </div>

        <div class="flex flex-col gap-2">
          <h3 class="
            text-xs font-semibold tracking-wider text-[hsl(var(--ink-muted))]
            uppercase
          "
          >Reference</h3>
          <Link
href="/docs/rules"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >Rules</Link>
          <Link
href="/docs/cli"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >CLI</Link>
          <Link
href="/docs/github-action"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >GitHub Action</Link>
          <Link
href="/docs/agent-skills"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >Agent Skills</Link>
        </div>

        <div class="flex flex-col gap-2">
          <h3 class="
            text-xs font-semibold tracking-wider text-[hsl(var(--ink-muted))]
            uppercase
          "
          >Project</h3>
          <Link
href={GITHUB_URL}
target="_blank"
rel="noopener noreferrer"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >GitHub</Link>
          <Link
href={NPM_URL}
target="_blank"
rel="noopener noreferrer"
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >npm</Link>
          <Link
href={CHANGELOG_URL}
class="
  text-sm text-[hsl(var(--ink-soft))] transition-colors
  hover:text-[hsl(var(--brand))]
"
          >Changelog</Link>
        </div>
      </div>
    </div>

    <div class="
      mt-10 flex flex-col items-center justify-between gap-3 border-t
      border-[hsl(var(--line)/0.4)] pt-6
      sm:flex-row
    "
    >
      <p class="text-xs text-[hsl(var(--ink-muted))]">
        &copy; {year} <Link
href={AUTHOR_URL}
target="_blank"
rel="noopener noreferrer"
class="
  transition-colors
  hover:text-[hsl(var(--brand))]
"
                      >{AUTHOR}</Link>. MIT License.
      </p>
      <p class="text-xs text-[hsl(var(--ink-muted))]">
        Built with <Link
href="https://lumen.santi020k.com"
target="_blank"
rel="noopener noreferrer"
class="
  transition-colors
  hover:text-[hsl(var(--brand))]
"
                   >Lumen UI</Link>
      </p>
    </div>
  </div>
</footer>

<style>
  :global(.site-footer .ui-link) {
    color: inherit;
    font-weight: inherit;
  }

  :global(.site-footer .ui-link:hover) {
    color: hsl(var(--brand));
  }
</style>
