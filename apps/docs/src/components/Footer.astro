---
import LogoMark from '@/components/logo-mark.astro'

import { ButtonLink, Icon, Link } from '@santi020k/lumen-astro'

import { AUTHOR, AUTHOR_URL, CHANGELOG_URL, GITHUB_URL, NPM_URL, REACT_DOCTOR_URL, SITE_NAME } from '@/site.config'

const year = new Date().getFullYear()

const linkGroups = [
  { title: 'Start here',
items: [
    { label: 'Introduction', href: '/docs' },
    { label: 'Installation', href: '/docs/installation' },
    { label: 'Quick start', href: '/docs/quick-start' },
    { label: 'Configuration', href: '/docs/configuration' }
  ] },
  { title: 'Reference',
items: [
    { label: 'Rules', href: '/docs/rules' },
    { label: 'CLI', href: '/docs/cli' },
    { label: 'GitHub Action', href: '/docs/github-action' },
    { label: 'Agent skills', href: '/docs/agent-skills' }
  ] },
  { title: 'Open source',
items: [
    { label: 'GitHub', href: GITHUB_URL },
    { label: 'npm package', href: NPM_URL },
    { label: 'Changelog', href: CHANGELOG_URL }
  ] }
]
---

<footer class="site-footer container-docs">
  <div class="site-footer-surface">
    <div class="site-footer-intro">
      <div>
        <span class="site-eyebrow">A little care goes a long way.</span>
        <h2>Better Astro.<br /><span>One check at a time.</span></h2>
      </div>
      <ButtonLink
href="/docs/quick-start"
variant="unstyled"
class="site-primary-action"
      >
        Run your first scan<span class="site-action-arrow"><Icon name="arrow-up-right" /></span>
      </ButtonLink>
    </div>
    <div class="site-footer-main">
      <div class="site-footer-brand">
        <Link href="/" variant="inherit" class="site-footer-brand-name"><LogoMark />{SITE_NAME}</Link>
        <p>Deterministic diagnostics.<br />Healthier projects.</p>
        <p class="site-footer-inspiration">Inspired by <Link href={REACT_DOCTOR_URL} newTab variant="inherit">react-doctor</Link>.</p>
      </div>
      <nav class="site-footer-navigation" aria-label="Footer">
        {linkGroups.map(group => (
          <div>
            <h3>{group.title}</h3>
            <ul>{group.items.map(item => <li><Link href={item.href} newTab={item.href.startsWith('https://')} variant="inherit">{item.label}</Link></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="site-footer-credits">
      <p>&copy; {year} <Link href={AUTHOR_URL} newTab variant="inherit">{AUTHOR}</Link>. MIT License.</p>
      <p>Made with <Link href="https://lumen.santi020k.com" newTab variant="inherit">Lumen UI<Icon name="arrow-up-right" /></Link></p>
    </div>
  </div>
</footer>
