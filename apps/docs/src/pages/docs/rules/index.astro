---
import CodeBlock from '@/components/code-block.astro'
import Docs from '@/layouts/Docs.astro'

import '../docs-pages.css'

import { Badge, Icon, Link, Stat, StatLabel, StatValue } from '@santi020k/lumen-astro'

import { CATEGORY_LABELS, PROJECT_AUDITS, RULES } from '@/data/rules'

const categories = Object.entries(CATEGORY_LABELS).map(([category, label]) => ({
  category,
  label,
  rules: RULES.filter(ruleDefinition => ruleDefinition.category === category)
})).filter(categoryDefinition => categoryDefinition.rules.length > 0)
---

<Docs
  title="Rules Overview"
  description={`${RULES.length} Astro Doctor rules, ${PROJECT_AUDITS.length} project audits, and up to 54 official Astro ecosystem rules. Explore the checks and see how to resolve each finding.`}
  editPath="apps/docs/src/pages/docs/rules/index.astro"
>
  <header class="docs-page-header">
    <h1>Small checks.<br /><span class="docs-title-accent">Better foundations.</span></h1>
    <p class="docs-page-lead">
      Understand what each rule catches, why it matters, and what a better pattern looks like.
      Start with the defaults. Tune the checks to your project.
    </p>
  </header>

  <div class="docs-stat-strip" role="group" aria-label="Rule catalog coverage">
    <Stat variant="bare">
      <StatValue>{RULES.length}</StatValue>
      <StatLabel>Astro Doctor rules</StatLabel>
    </Stat>
    <Stat variant="bare">
      <StatValue>{PROJECT_AUDITS.length}</StatValue>
      <StatLabel>Project audits</StatLabel>
    </Stat>
    <Stat variant="bare">
      <StatValue>54</StatValue>
      <StatLabel>Official Astro rules</StatLabel>
    </Stat>
  </div>

  <nav class="docs-category-links" aria-label="Rule categories">
    {categories.map(categoryDefinition => (
      <Link href={`#${categoryDefinition.category}`} variant="inherit">
        {categoryDefinition.label}<Icon name="arrow-down" decorative />
      </Link>
    ))}
    <Link href="#project-audits" variant="inherit">Project audits<Icon name="arrow-down" decorative /></Link>
  </nav>

  <p>
    Astro Doctor composes its rules with <code>eslint-plugin-astro</code>. The <code>all</code>
    preset enables 63 unique ESLint checks after overlap deduplication, plus project audits.
    Each rule below includes its default severity; you can change that in your configuration.
  </p>

  {categories.map(categoryDefinition => (
    <section aria-labelledby={categoryDefinition.category}>
      <h2 class="docs-catalog-heading" id={categoryDefinition.category}>
        {categoryDefinition.label}
        <span>{categoryDefinition.rules.length} checks</span>
      </h2>
      <ul class="docs-link-list">
        {categoryDefinition.rules.map(ruleDefinition => (
          <li class="docs-catalog-row">
            <Link class="docs-row-link" href={`/docs/rules/${ruleDefinition.slug}`} variant="inherit">
              <span class="docs-row-copy">
                <strong>{ruleDefinition.name}</strong>
                <span>{ruleDefinition.description}</span>
              </span>
              <Icon name="arrow-up-right" decorative />
            </Link>
            <div class="docs-rule-meta">
              <Badge variant={ruleDefinition.severity === 'error' ? 'destructive' : 'warning'}>
                {ruleDefinition.severity === 'warn' ? 'warning' : 'error'}
              </Badge>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section aria-labelledby="project-audits">
    <h2 class="docs-catalog-heading" id="project-audits">
      Project audits<span>{PROJECT_AUDITS.length} checks</span>
    </h2>
    <p>
      The CLI also evaluates configuration and relationships across files that an isolated ESLint
      rule cannot see. Preset labels show where each audit is enabled.
    </p>
    <ul class="docs-link-list">
      {PROJECT_AUDITS.map(projectAudit => (
        <li class="docs-catalog-row">
          <Link class="docs-row-link" href={`/docs/rules/${projectAudit.slug}`} variant="inherit">
            <span class="docs-row-copy">
              <strong>{projectAudit.name}</strong>
              <span>{projectAudit.description}</span>
            </span>
            <Icon name="arrow-up-right" decorative />
          </Link>
          <div class="docs-rule-meta">
            <Badge variant="outline">{projectAudit.preset}</Badge>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <h2>Make the rules yours</h2>
  <p>Override individual severities in your <code>eslint.config.js</code>:</p>

  <CodeBlock
    code={`import astroDoctorPlugin from '@santi020k/eslint-plugin-astro-doctor'

export default [
  astroDoctorPlugin.configs.recommended,
  {
    rules: {
      'astro-doctor/no-client-load-overuse': 'error',
      'astro-doctor/prefer-class-list': 'off',
    },
  },
]`}
    label="eslint.config.js"
    language="javascript"
  />

  <p>
    For CLI settings and project audits, use a
    <Link href="/docs/configuration"><code>doctor.config.*</code> file</Link>.
    Use <code>--fix</code> to apply automatic fixes offered by supported rules.
  </p>
</Docs>
