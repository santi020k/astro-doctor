---
import CodeBlock from '@/components/code-block.astro'
import Docs from '@/layouts/Docs.astro'

import { Badge, Link } from '@santi020k/lumen-astro'

import { CATEGORY_COLORS, CATEGORY_LABELS, RULES, SEVERITY_COLORS } from '@/data/rules'
---

<Docs
  title="Rules Overview"
  description={`${RULES.length} proprietary Astro Doctor rules plus up to 54 official Astro ecosystem rules.`}
  editPath="apps/docs/src/pages/docs/rules/index.astro"
>
  <h1>Rules</h1>

  <p>
    astro-doctor provides {RULES.length} proprietary ESLint rules for <code>.astro</code> files and
    composes them with up to 54 official <code>eslint-plugin-astro</code> rules. The
    <code>all</code> preset exposes 63 unique ESLint checks after overlap deduplication.
  </p>

  <h2>Proprietary rules</h2>

  <table>
    <thead>
      <tr>
        <th>Rule</th>
        <th>Category</th>
        <th>Default</th>
        <th>Fixable</th>
      </tr>
    </thead>
    <tbody>
      {RULES.map(rule => (
        <tr>
          <td>
            <Link href={`/docs/rules/${rule.slug}`}>
              <code>{rule.id}</code>
            </Link>
          </td>
          <td>
            <Badge class:list={[`
              inline-flex items-center rounded-sm px-1.5 py-0.5 text-xs
              font-medium
            `, CATEGORY_COLORS[rule.category]]}
            >
              {CATEGORY_LABELS[rule.category]}
            </Badge>
          </td>
          <td>
            <Badge class:list={[
              `
                inline-flex items-center rounded-sm px-1.5 py-0.5 text-xs
                font-medium
              `,
              SEVERITY_COLORS[rule.severity]
            ]}
            >
              {rule.severity}
            </Badge>
          </td>
          <td class="text-sm text-[hsl(var(--ink-muted))]">—</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Rule categories</h2>

  <h3>Performance</h3>
  <p>
    Rules that help you ship faster pages. Covers hydration strategies
    (<code>no-client-load-overuse</code>), image optimization (<code>use-astro-image</code>),
    image dimensions (<code>require-image-dimensions</code>), render-blocking scripts
    (<code>no-blocking-script</code>), and accidental script processing opt-outs
    (<code>no-unprocessed-script-surprises</code>).
  </p>

  <h3>Accessibility</h3>
  <p>
    Rules that ensure your pages are usable by everyone, including screen-reader users.
    Covers missing alt text (<code>no-missing-alt</code>) and missing language declaration
    (<code>no-missing-lang</code>), plus fallback content for islands
    (<code>require-island-fallback</code>).
  </p>

  <h3>Security</h3>
  <p>
    Rules that prevent common vulnerabilities. Covers unescaped HTML injection
    (<code>no-set-html</code>) and public environment variables that look like secrets
    (<code>no-public-secret-env</code>).
  </p>

  <h3>Best Practices</h3>
  <p>
    Rules that encourage idiomatic Astro patterns: conditional class composition
    (<code>prefer-class-list</code>), environment variable access (<code>no-process-env</code>),
    and content management (<code>prefer-content-collections</code>).
  </p>

  <h2>Customizing rules</h2>

  <p>Override any rule severity in your <code>eslint.config.js</code>:</p>

  <CodeBlock
    code={`import astroDoctorPlugin from '@santi020k/eslint-plugin-astro-doctor'

export default [
  astroDoctorPlugin.configs.recommended,
  {
    rules: {
      // Upgrade to error
      'astro-doctor/no-client-load-overuse': 'error',
      // Disable a rule
      'astro-doctor/prefer-class-list': 'off',
    },
  },
]`}
    label="eslint.config.js"
    language="javascript"
    theme="auto"
    variant="block"
    copy
  />

  <p>Or use a <Link href="/docs/configuration"><code>doctor.config.*</code></Link> file for CLI-only overrides.</p>
</Docs>
