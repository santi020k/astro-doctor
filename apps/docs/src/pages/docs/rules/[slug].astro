---
import type { GetStaticPaths } from 'astro'

import CodeBlock from '@/components/code-block.astro'
import Docs from '@/layouts/Docs.astro'

import '../docs-pages.css'

import { Badge, Icon, Link } from '@santi020k/lumen-astro'

import { ALL_RULES, CATEGORY_LABELS, PROJECT_AUDITS, RULE_BY_SLUG, RULES } from '@/data/rules'

export const getStaticPaths = (() => ALL_RULES.map(ruleDefinition => ({
  params: { slug: ruleDefinition.slug }
}))) satisfies GetStaticPaths

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/docs/rules')
}

const rule = RULE_BY_SLUG[slug]

if (!rule) {
  return Astro.redirect('/docs/rules')
}

const isEslintRule = RULES.some(candidateRule => candidateRule.slug === rule.slug)
const projectAuditRule = PROJECT_AUDITS.find(candidateRule => candidateRule.slug === rule.slug)

const relatedRules = ALL_RULES.filter(candidateRule => (
  candidateRule.category === rule.category && candidateRule.slug !== rule.slug
))
---

<Docs
  title={rule.name}
  description={rule.description}
  editPath="apps/docs/src/pages/docs/rules/[slug].astro"
>
  <header class="docs-page-header">
    <h1>{rule.name}</h1>
    <p class="docs-page-lead">{rule.description}</p>
    <div class="docs-rule-meta" role="group" aria-label="Rule details">
      <Badge variant="outline">{CATEGORY_LABELS[rule.category]}</Badge>
      <Badge variant={rule.severity === 'error' ? 'destructive' : 'warning'}>
        {rule.severity === 'warn' ? 'warning' : 'error'} by default
      </Badge>
      <Badge variant="secondary">{isEslintRule ? 'ESLint rule' : 'Project audit'}</Badge>
      {projectAuditRule && <Badge variant="outline">{projectAuditRule.preset} audit</Badge>}
    </div>
    <p class="docs-rule-id"><code>{rule.id}</code></p>
  </header>

  <h2>Why it matters</h2>
  <p>{rule.why}</p>

  <h2>See the difference</h2>

  <section class="docs-rule-example" data-result="incorrect" aria-labelledby="incorrect-example">
    <h3 class="docs-example-heading" id="incorrect-example">
      <Icon name="x" decorative />Incorrect
    </h3>
    <p>{rule.bad.label}</p>
    <CodeBlock
      code={rule.bad.code}
      label="Incorrect example"
      language={rule.bad.language ?? 'astro'}
    />
  </section>

  <section class="docs-rule-example" data-result="correct" aria-labelledby="correct-example">
    <h3 class="docs-example-heading" id="correct-example">
      <Icon name="check" decorative />Correct
    </h3>
    <p>{rule.good.label}</p>
    <CodeBlock
      code={rule.good.code}
      label="Correct example"
      language={rule.good.language ?? 'astro'}
    />
  </section>

  <h2>Configure this check</h2>

  {!isEslintRule ?
    (
      <>
        <p>Project audits are configured in <code>doctor.config.ts</code>:</p>
        <CodeBlock
          code={`export default {
  rules: {
    '${rule.id}': 'error',
  },
}`}
          label="doctor.config.ts"
          language="typescript"
        />
      </>
    ) :
    (
      <>
        <p>Override the default severity in your ESLint config:</p>
        <CodeBlock
          code={`import astroDoctorPlugin from '@santi020k/eslint-plugin-astro-doctor'

export default [
  astroDoctorPlugin.configs.recommended,
  {
    rules: {
      '${rule.id}': 'error',
    },
  },
]`}
          label="eslint.config.js"
          language="javascript"
        />
        <p>Or set the severity for CLI scans in <code>doctor.config.ts</code>:</p>
        <CodeBlock
          code={`export default {
  rules: {
    '${rule.id}': 'error',
  },
}`}
          label="doctor.config.ts"
          language="typescript"
        />
      </>
    )}

  <p>
    Use <code>'error'</code>, <code>'warn'</code>, or <code>'off'</code>.
    The <Link href="/docs/configuration">configuration guide</Link> covers presets and per-file overrides.
  </p>

  {relatedRules.length > 0 && (
    <>
      <h2>Keep exploring {CATEGORY_LABELS[rule.category].toLowerCase()}</h2>
      <ul class="docs-link-list">
        {relatedRules.map(relatedRule => (
          <li>
            <Link class="docs-row-link" href={`/docs/rules/${relatedRule.slug}`} variant="inherit">
              <span class="docs-row-copy">
                <strong>{relatedRule.name}</strong>
                <span>{relatedRule.description}</span>
              </span>
              <Icon name="arrow-up-right" decorative />
            </Link>
          </li>
        ))}
      </ul>
    </>
  )}

  <p><Link href="/docs/rules">Browse every rule and project audit</Link></p>
</Docs>
