---
import type { GetStaticPaths } from 'astro'

import CodeBlock from '@/components/code-block.astro'
import Docs from '@/layouts/Docs.astro'

import { Badge, Icon, Link } from '@santi020k/lumen-astro'

import {
  ALL_RULES,
  CATEGORY_COLORS,
  CATEGORY_LABELS,
  PROJECT_AUDITS,
  RULE_BY_SLUG,
  RULES,
  SEVERITY_COLORS
} from '@/data/rules'

export const getStaticPaths = (() => ALL_RULES.map(rule => ({
  params: { slug: rule.slug }
}))) satisfies GetStaticPaths

const { slug } = Astro.params
const rule = RULE_BY_SLUG[slug]

if (!rule) {
  return Astro.redirect('/docs/rules')
}

const isEslintRule = RULES.some(candidateRule => candidateRule.slug === rule.slug)
const projectAuditRule = PROJECT_AUDITS.find(candidateRule => candidateRule.slug === rule.slug)
---

<Docs
  title={rule.name}
  description={rule.description}
  editPath="apps/docs/src/pages/docs/rules/[slug].astro"
>
  <!-- Rule header -->
  <div class="mb-8 flex flex-wrap items-center gap-3">
    <Badge class:list={[`
      inline-flex items-center rounded-md px-2 py-1 text-xs font-semibold
    `, CATEGORY_COLORS[rule.category]]}
    >
      {CATEGORY_LABELS[rule.category]}
    </Badge>
    <Badge class:list={[
      `
        inline-flex items-center rounded-md border px-2 py-1 text-xs
        font-semibold
      `,
      SEVERITY_COLORS[rule.severity]
    ]}
    >
      {rule.severity} by default
    </Badge>
    {projectAuditRule && (
      <Badge class="
        inline-flex items-center rounded-md border px-2 py-1 text-xs
        font-semibold
      "
      >
        {projectAuditRule.preset} preset
      </Badge>
    )}
    <code class="
      rounded-md border border-[hsl(var(--line)/0.5)]
      bg-[hsl(var(--surface-muted))] px-2 py-1 text-xs text-[hsl(var(--brand))]
    "
    >
      {rule.id}
    </code>
  </div>

  <h1>{rule.name}</h1>

  <p><strong>{rule.description}</strong></p>

  <h2>Why</h2>
  <p>{rule.why}</p>

  <h2>Examples</h2>

  <h3>
    <span class="inline-flex items-center gap-1.5">
      <Icon class="text-[hsl(var(--danger))]" name="x" decorative />
      Incorrect
    </span>
  </h3>
  <p class="text-sm text-[hsl(var(--ink-muted))]">{rule.bad.label}</p>
  <CodeBlock
    code={rule.bad.code}
    language={rule.bad.language ?? 'astro'}
    theme="auto"
    variant="block"
    copy
  />

  <h3>
    <span class="inline-flex items-center gap-1.5">
      <Icon class="text-[hsl(var(--success))]" name="check" decorative />
      Correct
    </span>
  </h3>
  <p class="text-sm text-[hsl(var(--ink-muted))]">{rule.good.label}</p>
  <CodeBlock
    code={rule.good.code}
    language={rule.good.language ?? 'astro'}
    theme="auto"
    variant="block"
    copy
  />

  <h2>Configuration</h2>

  {!isEslintRule ?
    (
    <>
      <p>Project audits are configured in <code>doctor.config.ts</code>:</p>
      <CodeBlock
        code={`export default {
            rules: {
              '${rule.id}': 'error', // or 'warn' or 'off'
            },
          }`}
        label="doctor.config.ts"
        language="typescript"
        theme="auto"
        variant="block"
        copy
      />
    </>
    ) :
    (
    <>
      <p>Override the default severity in your ESLint config:</p>
      <CodeBlock
        code={`// eslint.config.js
import astroDoctorPlugin from '@santi020k/eslint-plugin-astro-doctor'

export default [
  astroDoctorPlugin.configs.recommended,
  {
    rules: {
      '${rule.id}': 'error',   // or 'warn' or 'off'
    },
  },
]`}
        label="eslint.config.js"
        language="javascript"
        theme="auto"
        variant="block"
        copy
      />
      <p>Or in your <Link href="/docs/configuration"><code>doctor.config.ts</code></Link>:</p>
      <CodeBlock
        code={`export default {
  rules: {
    '${rule.id}': 'error',
  },
}`}
        label="doctor.config.ts"
        language="typescript"
        theme="auto"
        variant="block"
        copy
      />
    </>
    )}

  <h2>All rules</h2>

  <ul>
    {ALL_RULES.map(innerRule => (
      <li>
        <Link
href={`/docs/rules/${innerRule.slug}`}
class:list={[innerRule.slug === slug ?
'font-semibold text-[hsl(var(--brand))]' :
'']}
        >
          <code>{innerRule.id}</code>
        </Link>
        {innerRule.slug === slug && (
<span class="ml-2 text-xs text-[hsl(var(--ink-muted))]">(this page)</span>
)}
      </li>
    ))}
  </ul>
</Docs>
