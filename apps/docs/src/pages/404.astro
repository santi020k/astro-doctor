---
import Base from '@/layouts/Base.astro'

import { ButtonLink } from '@santi020k/lumen-astro'
---

<Base title="Page not found" noIndex={true} ogImage="/og/index.webp">
  <div class="
    container-docs flex min-h-[60vh] flex-col items-center justify-center py-20
    text-center
  "
  >
    <div class="mb-6 text-8xl font-black text-[hsl(var(--brand)/0.15)]">404</div>
    <h1 class="mb-4 text-3xl font-bold text-[hsl(var(--ink))]">Page not found</h1>
    <p class="mb-8 text-[hsl(var(--ink-soft))]">
      This page doesn't exist. Maybe the docs moved?
    </p>
    <div class="flex gap-3">
      <ButtonLink
        href="/"
        variant="primary"
        class="
          rounded-xl bg-[hsl(var(--brand))] px-5 py-2.5 text-sm font-semibold
          text-white no-underline transition-colors
          hover:bg-[hsl(var(--brand-solid))]
        "
      >
        Go home
      </ButtonLink>
      <ButtonLink
        href="/docs"
        variant="secondary"
        class="
          rounded-xl border border-[hsl(var(--line))] px-5 py-2.5 text-sm
          font-medium text-[hsl(var(--ink))] no-underline transition-colors
          hover:bg-[hsl(var(--surface-muted))]
        "
      >
        Read docs
      </ButtonLink>
    </div>
  </div>
</Base>
