---
import Base from '@/layouts/Base.astro'

import { ButtonLink, Icon } from '@santi020k/lumen-astro'
---

<Base title="Page not found" noIndex={true}>
  <div class="container-docs">
    <section class="missing-page" aria-labelledby="missing-title">
      <p class="site-eyebrow">404 / Route not found</p>
      <h1 id="missing-title">A missing page.<br /><span>An easy recovery.</span></h1>
      <p>This address doesn't lead to a page. Find your next step in the documentation, or start again from home.</p>
      <div class="missing-actions">
        <ButtonLink href="/docs" variant="unstyled" class="site-primary-action" showArrow>Explore the docs</ButtonLink>
        <ButtonLink href="/" variant="ghost"><Icon name="arrow-left" decorative /> Back home</ButtonLink>
      </div>
    </section>
  </div>
</Base>

<style>
  .missing-page { padding: clamp(2rem, 7vw, 6rem) clamp(1.5rem, 4vw, 3rem); margin-block: 1rem; border-radius: 1.5rem; background: hsl(var(--surface)); }
  h1 { margin: 2rem 0; font-size: clamp(2.25rem, 5vw, 4.5rem); font-weight: 500; line-height: 1.1; letter-spacing: -.06em; }
  h1 span { color: hsl(var(--ink-soft)); }
  p:not(.site-eyebrow) { max-width: 30rem; font-size: .9375rem; line-height: 1.85; color: hsl(var(--ink-soft)); }
  .missing-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
</style>
