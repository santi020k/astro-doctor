---
import CodeBlock from '@/components/code-block.astro'
import Base from '@/layouts/Base.astro'

import { Badge, ButtonLink, Icon, ScrollReveal, Stat } from '@santi020k/lumen-astro'

import { HOME_FEATURES, HOME_GRADES, HOME_RULE_SLUGS } from '@/data/home'
import { ALL_RULES, CATEGORY_LABELS, PROJECT_AUDITS, RULES } from '@/data/rules'
import { GITHUB_URL, REACT_DOCTOR_URL } from '@/site.config'

const featuredRules = ALL_RULES.filter(rule => HOME_RULE_SLUGS.includes(rule.slug))
---

<Base title="astro-doctor" description="Your agent writes bad Astro. This catches it. Deterministic diagnostics, clear fixes, and a health score for your Astro project." headerVariant="signature">
  <div class="container-docs">
    <section class="signature-frame home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="home-eyebrow"><span class="status-dot" aria-hidden="true"></span> A second opinion for your Astro code</p>
        <h1 id="home-title">Your agent writes<br />bad Astro.<br /><span>This catches it.</span></h1>
        <p class="hero-description">Ship the idea. Catch the mistakes. Find performance, accessibility, and security issues with diagnostics that tell you what to fix.</p>
        <div class="home-actions">
          <ButtonLink
href="/docs/quick-start"
variant="unstyled"
class="home-primary"
          >Run your first scan <span><Icon class="home-icon" name="arrow-right" decorative /></span></ButtonLink>
          <ButtonLink
href={GITHUB_URL}
newTab
variant="unstyled"
class="home-secondary"
          >Explore the source <Icon class="home-icon" name="arrow-up-right" decorative /></ButtonLink>
        </div>
        <div class="hero-command">
          <CodeBlock code="pnpm dlx @santi020k/astro-doctor@latest" language="bash" label="Try it without installing" wrap={false} />
        </div>
      </div>

      <div class="health-report" aria-label="Illustrative scan report">
        <div class="report-heading"><Icon class="home-icon" name="activity" decorative /><span>Project health</span><Badge variant="outline">Example scan</Badge></div>
        <div class="report-score"><span class="score-value">74<span>/100</span></span><div><span class="
          report-grade
        "
                                                                                           >C · Needs attention</span><p>Clear findings.<br />A place to start.</p></div></div>
        <div class="score-track" aria-hidden="true"><span></span></div>
        <div class="report-summary"><span>14 files scanned</span><span>2 errors · 2 warnings</span></div>
        <ul class="report-findings">
          <li><Icon class="home-icon" name="shield-alert" decorative /><div><strong>Sanitize raw HTML</strong><code>no-set-html</code></div><span class="
            finding-error
          "
                                                                                                                                            >error</span></li>
          <li><Icon class="home-icon" name="image" decorative /><div><strong>Describe the image</strong><code>no-missing-alt</code></div><span class="
            finding-error
          "
                                                                                                                                         >error</span></li>
          <li><Icon class="home-icon" name="zap" decorative /><div><strong>Hydrate when needed</strong><code>no-client-load-overuse</code></div><span class="
            finding-warning
          "
                                                                                                                                                >warn</span></li>
          <li><Icon class="home-icon" name="scan" decorative /><div><strong>Optimize your images</strong><code>use-astro-image</code></div><span class="
            finding-warning
          "
                                                                                                                                           >warn</span></li>
        </ul>
        <p class="report-note"><Icon class="home-icon" name="info" decorative />Unresolved security errors cap the score at 74.</p>
      </div>
      <div class="hero-footnote"><span>Built for Astro. Open source by design.</span><span>CLI / ESLint / Editor / CI</span></div>
    </section>

    <div class="home-facts" aria-label="Project at a glance">
      <Stat variant="bare" value={String(RULES.length)} label="Astro ESLint rules" />
      <Stat variant="bare" value={String(PROJECT_AUDITS.length)} label="Project audit checks" />
      <Stat variant="bare" value="0–100" label="Project health score" />
      <Stat variant="bare" value="MIT" label="Open source license" />
    </div>

    <ScrollReveal as="section" animation="slide-up" class="home-section" aria-labelledby="workflow-title">
      <div class="section-intro"><p class="home-eyebrow">01 / The workflow</p><h2 id="workflow-title">Good habits.<br /><span>Where you already work.</span></h2><p>One set of diagnostics, from your first local scan to the pull request that ships it.</p></div>
      <div class="workflow-grid">
        {HOME_FEATURES.map(feature => (
          <a href={feature.href} class="workflow-link">
            <Icon class="home-icon" name={feature.icon} decorative />
            <div><h3>{feature.title}</h3><p>{feature.description}</p></div>
            <Icon class="home-icon" name="arrow-up-right" decorative />
          </a>
        ))}
      </div>
    </ScrollReveal>

    <ScrollReveal
as="section"
animation="slide-up"
class="home-section rules-section"
aria-labelledby="rules-title"
    >
      <div class="section-intro"><p class="home-eyebrow">02 / The diagnosis</p><h2 id="rules-title">Small details.<br /><span>Real consequences.</span></h2><p>Every finding names the problem, explains why it matters, and shows a better pattern.</p><ButtonLink
href="/docs/rules"
variant="unstyled"
class="home-secondary"
                                                                                                                                                                                                                                                        >Explore every rule <Icon
class="home-icon"
name="arrow-right"
decorative
                                                                                                                                                                                                                                                                            /></ButtonLink></div>
      <div class="rule-preview">
        {featuredRules.map(rule => (
          <a class="rule-preview-link" href={`/docs/rules/${rule.slug}`}>
            <div><span class="rule-category">{CATEGORY_LABELS[rule.category]}</span><h3>{rule.name}</h3><p>{rule.description}</p></div>
            <Icon class="home-icon" name="arrow-up-right" decorative />
          </a>
        ))}
      </div>
    </ScrollReveal>

    <ScrollReveal
as="section"
animation="slide-up"
class="home-section score-section"
aria-labelledby="score-title"
    >
      <div class="section-intro"><p class="home-eyebrow">03 / A useful signal</p><h2 id="score-title">Know where<br /><span>your project stands.</span></h2><p>A score you can act on. Review the findings, fix the cause, and keep new issues out of your next pull request.</p></div>
      <div>
        <div class="grade-list">
          {HOME_GRADES.map(grade => (<div class:list={['grade-item', grade.tone]}><strong>{grade.label}</strong><span>{grade.range}</span><span>{grade.description}</span></div>))}
        </div>
        <p class="score-explanation">Each file starts at 100. Errors cost 25 points and warnings cost 10; file scores are clamped at zero, then averaged. Unresolved errors cap the result at 89, or 74 for security errors.</p>
        <ButtonLink
href="/docs#health-score"
variant="unstyled"
class="home-secondary"
        >Understand the score <Icon class="home-icon" name="arrow-right" decorative /></ButtonLink>
      </div>
    </ScrollReveal>

    <ScrollReveal as="section" animation="slide-up" class="home-start" aria-labelledby="start-title">
      <div><p class="home-eyebrow">Your next commit can be better</p><h2 id="start-title">Start with<br />a second opinion.</h2><p>Run a scan. Read the findings. Ship with more confidence.</p><ButtonLink
href="/docs/quick-start"
variant="unstyled"
class="home-primary"
                                                                                                                                                                                                >Get started <span><Icon
class="home-icon"
name="arrow-right"
decorative
                                                                                                                                                                                                                   /></span></ButtonLink></div>
      <div class="start-steps"><div><span>01</span><div><h3>Scan your project</h3><CodeBlock code="pnpm dlx @santi020k/astro-doctor@latest" language="bash" wrap={false} /></div></div><div><span>02</span><div><h3>Teach your coding agent</h3><CodeBlock code="pnpm dlx @santi020k/astro-doctor@latest install" language="bash" wrap={false} /></div></div><p>Ready for CI? <a href="/docs/github-action">Add the GitHub Action <Icon
class="home-icon"
name="arrow-right"
decorative
                                                                                                                                                                                                                                                                                                                                                                                                                                  /></a></p></div>
    </ScrollReveal>

    <p class="home-credit">Inspired by <a href={REACT_DOCTOR_URL} target="_blank" rel="noopener noreferrer">react-doctor</a> by Million Software. The same care, built for the Astro ecosystem.</p>
  </div>
</Base>

<style>
  .home-hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 3.5rem; padding: clamp(1.5rem, 4vw, 3.5rem); }
  .home-eyebrow { display: flex; align-items: center; gap: .625rem; font-size: .625rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: hsl(var(--ink-soft)); }
  .status-dot { width: .375rem; height: .375rem; border-radius: 50%; background: hsl(var(--brand)); }
  h1 { margin: 1.75rem 0 1.5rem; font-size: clamp(2.5rem, 4.7vw, 4.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -.065em; }
  h1 > span { color: hsl(var(--brand)); }
  .hero-description { max-width: 28rem; font-size: .9375rem; line-height: 1.85; color: hsl(var(--ink-soft)); }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 2rem; }
  :global(.home-primary) { max-width: 100%; display: inline-flex; min-height: 3rem; align-items: center; gap: 1.25rem; padding: .5rem .5rem .5rem 1rem; border-radius: .875rem; background: hsl(var(--ink)); color: hsl(var(--canvas)); font-size: .75rem; font-weight: 600; text-decoration: none; transition: background .2s; }
  :global(.home-primary > span) { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .5rem; background: hsl(var(--canvas) / .12); }
  :global(.home-primary:hover) { background: hsl(var(--ink-soft)); text-decoration: none; }
  :global(.home-secondary) { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .75rem; color: hsl(var(--ink)); font-size: .75rem; font-weight: 500; text-decoration: none; }
  :global(.home-secondary:hover) { color: hsl(var(--brand)); text-decoration: underline; text-underline-offset: .25rem; }
  .hero-command { max-width: 31rem; margin-top: 1.5rem; }
  .hero-command :global([data-slot="code"]) { font-size: .75rem; }
  .health-report { align-self: center; min-width: 0; padding: 1.5rem; border: 1px solid hsl(var(--line)); border-radius: 1.5rem; background: hsl(var(--canvas)); }
  .report-heading { display: flex; align-items: center; gap: .5rem; color: hsl(var(--ink)); font-size: .75rem; font-weight: 600; }
  .report-heading :global([data-slot="badge"]) { margin-left: auto; font-size: .625rem; }
  .report-heading > :global(.home-icon) { color: hsl(var(--brand)); }
  .report-score { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin: 2rem 0 1.25rem; }
  .score-value { font-size: 5.5rem; line-height: 1; font-weight: 500; letter-spacing: -.075em; font-variant-numeric: tabular-nums; }
  .score-value > span { font-size: 1rem; letter-spacing: -.025em; color: hsl(var(--ink-soft)); }
  .report-grade { font-size: .625rem; font-weight: 600; color: hsl(var(--warning)); }
  .report-score p { margin-top: .5rem; font-size: .75rem; line-height: 1.6; color: hsl(var(--ink-soft)); }
  .score-track { height: .25rem; background: hsl(var(--line)); border-radius: 1rem; }
  .score-track > span { display: block; width: 74%; height: 100%; border-radius: inherit; background: hsl(var(--brand)); }
  .report-summary { display: flex; justify-content: space-between; gap: 1rem; margin: .75rem 0 1.25rem; color: hsl(var(--ink-soft)); font-size: .625rem; }
  .report-findings { padding: 0; margin: 0; list-style: none; }
  .report-findings li { display: flex; align-items: center; gap: .75rem; padding: .875rem 0; border-top: 1px solid hsl(var(--line) / .7); }
  .report-findings li > :global(.home-icon) { flex-shrink: 0; color: hsl(var(--ink-soft)); }
  .report-findings li > div { min-width: 0; }
  .report-findings strong { display: block; font-size: .6875rem; font-weight: 500; }
  .report-findings code { display: block; padding: 0; margin-top: .25rem; border: 0; background: none; font-size: .625rem; color: hsl(var(--ink-soft)); overflow-wrap: anywhere; }
  .finding-error, .finding-warning { margin-left: auto; font-family: var(--font-mono); font-size: .625rem; }
  .finding-error { color: hsl(var(--danger)); }
  .finding-warning { color: hsl(var(--warning)); }
  .report-note { display: flex; align-items: flex-start; gap: .5rem; margin-top: .5rem; font-size: .625rem; line-height: 1.65; color: hsl(var(--ink-soft)); }
  .report-note :global(.home-icon) { flex-shrink: 0; }
  .hero-footnote { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; padding-top: 1.5rem; border-top: 1px solid hsl(var(--line) / .7); color: hsl(var(--ink-soft)); font-size: .625rem; }
  .home-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; padding: 2.5rem 0; border-bottom: 1px solid hsl(var(--line) / .65); }
  .home-facts :global([data-slot="stat"]) { display: flex; flex-direction: column-reverse; align-items: flex-start; gap: .5rem; padding-inline: 1.5rem; }
  .home-facts :global([data-slot="stat-value"]) { font-size: 1.75rem; font-weight: 500; letter-spacing: -.05em; }
  .home-facts :global([data-slot="stat-label"]) { font-size: .625rem; font-weight: 400; color: hsl(var(--ink-soft)); }
  :global(.home-section) { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.4fr); align-items: start; gap: 5rem; padding-block: 6rem; border-bottom: 1px solid hsl(var(--line) / .65); }
  h2 { margin: 1.5rem 0; font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 500; line-height: 1.12; letter-spacing: -.06em; }
  h2 span { color: hsl(var(--ink-soft)); }
  .section-intro > p:not(.home-eyebrow), .home-start p:not(.home-eyebrow) { font-size: .875rem; line-height: 1.85; color: hsl(var(--ink-soft)); }
  .section-intro > :global(.home-secondary) { margin-top: 1.5rem; }
  .workflow-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  .workflow-link { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; padding: 1.5rem 0; color: hsl(var(--ink)); text-decoration: none; border-bottom: 1px solid hsl(var(--line) / .65); }
  .workflow-link > :global(.home-icon):first-child { grid-column: 1 / -1; color: hsl(var(--brand)); }
  .workflow-link > :global(.home-icon):last-child { margin-top: .125rem; }
  .workflow-link h3 { font-size: .9375rem; font-weight: 600; letter-spacing: -.025em; }
  .workflow-link p { margin-top: .625rem; font-size: .75rem; line-height: 1.8; color: hsl(var(--ink-soft)); }
  .workflow-link:hover h3, .rule-preview-link:hover h3 { color: hsl(var(--brand)); text-decoration: underline; text-underline-offset: .25rem; }
  .workflow-link:hover, .rule-preview-link:hover { text-decoration: none; }
  .rule-preview-link { display: flex; justify-content: space-between; gap: 1.5rem; padding: 1.5rem 0; border-top: 1px solid hsl(var(--line) / .65); color: hsl(var(--ink)); text-decoration: none; }
  .rule-preview-link > :global(.home-icon) { flex-shrink: 0; margin-top: 1.75rem; }
  .rule-category { color: hsl(var(--ink-soft)); font-size: .625rem; }
  .rule-preview-link h3 { margin: .5rem 0; font-family: var(--font-mono); font-size: .875rem; font-weight: 500; overflow-wrap: anywhere; }
  .rule-preview-link p { font-size: .75rem; line-height: 1.75; color: hsl(var(--ink-soft)); }
  .grade-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; }
  .grade-item { display: flex; flex-direction: column; align-items: flex-start; gap: .5rem; padding: 1.25rem; border-radius: 1rem; border-width: 1px; }
  .grade-item strong { font-size: 2rem; font-weight: 500; line-height: 1.15; }
  .grade-item span { font-size: .625rem; color: hsl(var(--ink-soft)); }
  .score-explanation { margin-top: 1.5rem; font-size: .75rem; line-height: 1.8; color: hsl(var(--ink-soft)); }
  .score-section :global(.home-secondary) { margin-top: .5rem; }
  :global(.home-start) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem; margin-top: 5rem; padding: clamp(1.5rem, 4vw, 3.5rem); border-radius: 1.5rem; background: hsl(var(--brand-soft)); }
  .home-start h2 { margin-top: 1.5rem; }
  .home-start :global(.home-primary) { margin-top: 1.5rem; }
  .start-steps { align-self: center; min-width: 0; }
  .start-steps > div { display: flex; gap: 1rem; padding-block: 1rem; }
  .start-steps > div > span { padding-top: .125rem; font-size: .625rem; color: hsl(var(--ink-soft)); }
  .start-steps > div > div { min-width: 0; flex: 1; }
  .start-steps h3 { margin-bottom: .5rem; font-size: .875rem; font-weight: 500; }
  .start-steps > p { margin: 1rem 0 0 1.75rem; }
  .start-steps a { display: inline-flex; align-items: center; gap: .5rem; color: hsl(var(--ink)); text-decoration: underline; text-underline-offset: .25rem; }
  .home-credit { max-width: 35rem; margin: 2rem auto 5rem; text-align: center; font-size: .75rem; line-height: 1.8; color: hsl(var(--ink-soft)); }
  .home-credit a { color: hsl(var(--ink)); text-decoration: underline; text-underline-offset: .2rem; }
  @media (max-width: 64rem) { .home-hero { gap: 2rem; } :global(.home-section) { gap: 3rem; } .health-report { padding: 1.25rem; } }
  @media (max-width: 48rem) {
    .home-hero { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    h1 { font-size: clamp(2rem, calc(1.5rem + 3vw), 3.75rem); }
    .hero-description { max-width: 34rem; }
    .health-report { max-width: 32rem; width: 100%; }
    .home-facts { grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr)); gap: 1.5rem .5rem; }
    .home-facts :global([data-slot="stat"]) { padding-inline: .5rem; }
    :global(.home-section) { grid-template-columns: minmax(0, 1fr); gap: 2rem; padding-block: 4rem; }
    :global(.home-start) { grid-template-columns: minmax(0, 1fr); gap: 2rem; margin-top: 3rem; }
    .hero-footnote { font-size: .625rem; }
  }
  @media (max-width: 24rem) { .workflow-grid { grid-template-columns: minmax(0, 1fr); } .grade-list { grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr)); } .report-heading { flex-wrap: wrap; } .report-heading :global([data-slot="badge"]) { margin-left: 0; } }
  @media (prefers-reduced-motion: reduce) { :global(.home-primary) { transition: none; } }

  @media (max-width: 24rem) {
    .home-hero { padding: min(1.5rem, 6vw); }
    :global(.home-start) { padding: min(1.5rem, 6vw); }
    .health-report { padding: min(1.25rem, 5vw); }
  }
</style>
