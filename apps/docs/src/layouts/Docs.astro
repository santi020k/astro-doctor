---
import DocsSidebar from '@/components/DocsSidebar.astro'

import { Link, Pagination, Prose } from '@santi020k/lumen-astro'

import { DOCS_NAV } from '@/data/nav'
import { getOgImagePath } from '@/site.config'

import Base from './Base.astro'

interface Props {
  title: string
  description?: string
  editPath?: string
}

const { title, description, editPath } = Astro.props
const ogImage = getOgImagePath(Astro.url.pathname)
const encodedEditPath = editPath?.split('/').map(pathSegment => encodeURIComponent(pathSegment)).join('/')
// Find prev/next pages for navigation
const allPages = DOCS_NAV.flatMap(section => section.items)
const currentPath = Astro.url.pathname.replace(/\/$/, '')
const currentIndex = allPages.findIndex(p => p.href === currentPath)
const prevPage = currentIndex > 0 ? allPages[currentIndex - 1] : undefined
const nextPage = currentIndex < allPages.length - 1 ? allPages[currentIndex + 1] : undefined
---

<Base title={title} description={description} ogImage={ogImage} ogType="article">
  <div class="
    container-docs py-8
    lg:py-12
  "
  >
    <div class="flex gap-12">
      <DocsSidebar />

      <!-- Main content -->
      <div class="min-w-0 flex-1">
        <Prose class="docs-prose prose max-w-none">
          <slot />
        </Prose>

        <!-- Pagination -->
        {(prevPage ?? nextPage) && (
          <Pagination
            class="
              docs-pagination mt-12 flex gap-4 border-t
              border-[hsl(var(--line)/0.4)] pt-8
            "
          >
            {prevPage && (
              <Link
                href={prevPage.href}
                class="
                  group flex flex-1 flex-col gap-1 rounded-xl border
                  border-[hsl(var(--line)/0.4)] px-5 py-4 no-underline
                  transition-colors
                  hover:border-[hsl(var(--brand)/0.4)]
                  hover:bg-[hsl(var(--surface-muted))]
                "
              >
                <span class="text-xs text-[hsl(var(--ink-muted))]">← Previous</span>
                <span class="
                  text-sm font-medium text-[hsl(var(--ink))] transition-colors
                  group-hover:text-[hsl(var(--brand))]
                "
                >
                  {prevPage.label}
                </span>
              </Link>
            )}
            {nextPage && (
              <Link
                href={nextPage.href}
                class="
                  group ml-auto flex flex-1 flex-col gap-1 rounded-xl border
                  border-[hsl(var(--line)/0.4)] px-5 py-4 text-right
                  no-underline transition-colors
                  hover:border-[hsl(var(--brand)/0.4)]
                  hover:bg-[hsl(var(--surface-muted))]
                "
              >
                <span class="text-xs text-[hsl(var(--ink-muted))]">Next →</span>
                <span class="
                  text-sm font-medium text-[hsl(var(--ink))] transition-colors
                  group-hover:text-[hsl(var(--brand))]
                "
                >
                  {nextPage.label}
                </span>
              </Link>
            )}
          </Pagination>
        )}

        <!-- Edit on GitHub -->
        {encodedEditPath && (
          <div class="mt-8 text-right">
            <Link
              href={`https://github.com/santi020k/astro-doctor/edit/main/${encodedEditPath}`}
              target="_blank"
              rel="noopener noreferrer"
              class="
                text-xs text-[hsl(var(--ink-muted))] transition-colors
                hover:text-[hsl(var(--brand))]
              "
            >
              Edit this page on GitHub ↗
            </Link>
          </div>
        )}
      </div>
    </div>
  </div>
</Base>

<style>
  :global(.docs-prose.ui-prose) {
    max-width: none;
    color: inherit;
    line-height: inherit;
  }

  :global(.docs-pagination.ui-pagination) {
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: initial;
    gap: 1rem;
  }

  :global(.docs-pagination.ui-pagination .ui-link) {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: initial;
    border-radius: 0.75rem;
    background: transparent;
    color: inherit;
    padding: 1rem 1.25rem;
    font-weight: inherit;
  }

  :global(.docs-pagination.ui-pagination .ui-link:hover) {
    border-color: hsl(var(--brand) / 0.4);
    background: hsl(var(--surface-muted));
    color: inherit;
  }
</style>
