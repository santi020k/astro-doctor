---
import DocsSidebar from '@/components/DocsSidebar.astro'

import { getOgImagePath } from '@/lib/generated-social-image'

import { Icon, Link, Pagination, Prose } from '@santi020k/lumen-astro'

import { DOCS_NAV } from '@/data/nav'

import Base from './Base.astro'

interface Props {
  title: string
  description?: string
  editPath?: string
}

const { title, description, editPath } = Astro.props
const ogImage = getOgImagePath(Astro.url.pathname)
const encodedEditPath = editPath?.split('/').map(pathSegment => encodeURIComponent(pathSegment)).join('/')
const allPages = DOCS_NAV.flatMap(section => section.items)
const currentPath = Astro.url.pathname.replace(/\/$/, '')
const currentIndex = allPages.findIndex(page => page.href === currentPath)
const currentSection = DOCS_NAV.find(section => section.items.some(page => page.href === currentPath))
const prevPage = currentIndex > 0 ? allPages[currentIndex - 1] : undefined
const nextPage = currentIndex >= 0 && currentIndex < allPages.length - 1 ? allPages[currentIndex + 1] : undefined
---

<Base title={title} description={description} ogImage={ogImage} ogType="article">
  <div class="container-docs docs-shell">
    <DocsSidebar />
    <div class="docs-reading-column">
      <nav class="docs-breadcrumb" aria-label="Breadcrumb">
        <Link href="/docs" variant="inherit">Documentation</Link>
        {currentSection && <><span aria-hidden="true">/</span><span>{currentSection.title}</span></>}
      </nav>
      <Prose class="docs-prose prose">
        <slot />
      </Prose>

      {(prevPage ?? nextPage) && (
        <Pagination class="docs-pagination" aria-label="Previous and next pages">
          {prevPage && (
            <Link
href={prevPage.href}
variant="inherit"
class="docs-page-link docs-page-link-previous"
            >
              <span class="docs-page-direction"><Icon name="arrow-left" />Previous</span>
              <span class="docs-page-title">{prevPage.label}</span>
            </Link>
          )}
          {nextPage && (
            <Link
href={nextPage.href}
variant="inherit"
class="docs-page-link docs-page-link-next"
            >
              <span class="docs-page-direction">Next<Icon name="arrow-right" /></span>
              <span class="docs-page-title">{nextPage.label}</span>
            </Link>
          )}
        </Pagination>
      )}

      {encodedEditPath && (
        <div class="docs-edit-link">
          <Link href={`https://github.com/santi020k/astro-doctor/edit/main/${encodedEditPath}`} newTab variant="inherit">
            Improve this page<Icon name="arrow-up-right" />
          </Link>
        </div>
      )}
    </div>
  </div>
</Base>
