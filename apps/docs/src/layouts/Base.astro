---
import Footer from '@/components/Footer.astro'
import Nav from '@/components/Nav.astro'

import '@/styles/global.css'

import { SkipLink } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'
import MetadataHead from '@santi020k/og/astro/head'
import {
  articleSchema,
  breadcrumbSchema,
  personSchema,
  serializeJsonLd,
  softwareApplicationSchema,
  webSiteSchema
} from '@santi020k/og/schema'
import { defineSite } from '@santi020k/og/site'

import {
  AUTHOR,
  AUTHOR_URL,
  FREE_SOFTWARE_PRICE_USD,
  getOgImagePath,
  GITHUB_URL,
  NPM_URL,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  TWITTER_HANDLE } from '@/site.config'

interface Props {
  title: string
  description?: string
  ogImage?: string
  ogImageAlt?: string
  ogType?: 'website' | 'article'
  noIndex?: boolean
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  noIndex = false
} = Astro.props

const resolvedOgImage = ogImage ?
  new URL(ogImage, Astro.site ?? SITE_URL).href :
  new URL(getOgImagePath(Astro.url.pathname), Astro.site ?? SITE_URL).href

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`
const metadataDescription = description.replace(/<([^>]+)>/gu, '$1')
const resolvedOgImageAlt = ogImageAlt ?? `${title} — ${SITE_NAME}`
const imageType = resolvedOgImage.endsWith('.png') ? 'image/png' : 'image/webp'

const site = defineSite({
  locale: 'en_US',
  siteName: SITE_NAME,
  siteUrl: Astro.site ?? SITE_URL,
  titleTemplate: title === SITE_NAME ? '%s' : `%s · ${SITE_NAME}`
})

const page = site.page({
  authors: [AUTHOR],
  description: metadataDescription,
  image: { alt: resolvedOgImageAlt, type: imageType, url: resolvedOgImage },
  pathname: Astro.url.pathname,
  robots: { follow: !noIndex, index: !noIndex },
  title,
  twitter: { creator: TWITTER_HANDLE, site: TWITTER_HANDLE },
  type: ogType
})

const pathnameSegments = Astro.url.pathname.split('/').filter(Boolean)

const breadcrumbs = pathnameSegments.length > 0 ?
  [
    {
      name: 'Home',
      url: new URL('/', Astro.site ?? SITE_URL).href
    },
    ...pathnameSegments.map((segment, index) => ({
      name: index === pathnameSegments.length - 1 ?
        title :
        segment
          .split('-')
          .map(word => `${word.charAt(0).toUpperCase()}${word.slice(1)}`)
          .join(' '),
      url: new URL(`/${pathnameSegments.slice(0, index + 1).join('/')}/`, Astro.site ?? SITE_URL).href
    }))
  ] :
  []

const authorSchema = personSchema({ name: AUTHOR, url: AUTHOR_URL })

const websiteJsonLd = serializeJsonLd(webSiteSchema({
  id: `${SITE_URL}/#website`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  description: SITE_DESCRIPTION,
  inLanguage: 'en-US'
}, { author: authorSchema }))

const softwareJsonLd = serializeJsonLd(softwareApplicationSchema({
  id: `${SITE_URL}/#software`,
  name: SITE_NAME,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  description: 'ESLint plugin, CLI, and GitHub Action for diagnosing Astro codebases.',
  url: `${SITE_URL}/`,
  downloadUrl: NPM_URL,
  author: authorSchema,
  offers: {
    '@type': 'Offer',
    price: FREE_SOFTWARE_PRICE_USD,
    priceCurrency: 'USD'
  }
}, {
  codeRepository: GITHUB_URL,
  license: 'https://opensource.org/licenses/MIT',
  softwareHelp: `${SITE_URL}/docs/`
}))

const articleJsonLd = ogType === 'article' ?
serializeJsonLd(articleSchema({
  id: `${canonical}#article`,
  name: fullTitle,
  description: metadataDescription,
  url: canonical,
  image: resolvedOgImage,
  inLanguage: 'en-US',
  author: authorSchema,
  publisher: authorSchema,
  type: 'TechArticle'
}, {
  isPartOf: { '@id': `${SITE_URL}/#website`, '@type': 'WebSite' },
  mainEntityOfPage: { '@id': canonical, '@type': 'WebPage' }
})) :
null

const breadcrumbsJsonLd = breadcrumbs.length > 0 ?
  serializeJsonLd(breadcrumbSchema(breadcrumbs.map(breadcrumb => ({
    name: breadcrumb.name,
    url: breadcrumb.url
  })))) :
  null
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <MetadataHead {page} site={site.options} />
    <meta name="title" content={fullTitle} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme init (inline to prevent flash) -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme')
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'

        document.documentElement.setAttribute('data-theme', saved ?? preferred)
      })()
    </script>

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
    <script type="application/ld+json" is:inline set:html={softwareJsonLd} />
    {articleJsonLd && <script type="application/ld+json" is:inline set:html={articleJsonLd} />}
    {breadcrumbsJsonLd && <script type="application/ld+json" is:inline set:html={breadcrumbsJsonLd} />}
  </head>
  <body>
    <SkipLink href="#main-content">Skip to content</SkipLink>
    <Nav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <UIPrimitives />

    <!-- Scroll reveal -->
    <script>
const observer = new IntersectionObserver(
  observerEntries => {
    for (const entry of observerEntries) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible')

        const stagger = entry.target instanceof HTMLElement ? entry.target.dataset['stagger'] : undefined

        if (stagger) {
          const delay = Number(stagger)
          const children = entry.target.children
          let childIndex = 0

          for (const childNode of children) {
            if (childNode instanceof HTMLElement) {
              childNode.style.transitionDelay = `${childIndex * delay}ms`
            }

            childIndex += 1
          }
        }

        observer.unobserve(entry.target)
      }
    }
  }, { threshold: 0.08 }
)

for (const elementNode of document.querySelectorAll('[data-reveal], [data-stagger]')) {
  observer.observe(elementNode)
}
</script>
  </body>
</html>
