{
  "name": "@santi020k/astro-doctor-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "pnpm run lint:repo && turbo run lint",
    "lint:repo": "eslint . --cache --no-warn-ignored --max-warnings=0",
    "lint:fix": "pnpm run lint:repo:fix && turbo run lint:fix",
    "lint:repo:fix": "eslint . --cache --fix --no-warn-ignored --max-warnings=0",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "lint:knip": "knip",
    "check:packed-install": "node scripts/check-packed-install.mjs",
    "ok": "pnpm install --reporter=silent && turbo run build && turbo run test && pnpm run lint:repo && turbo run lint && turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && pnpm run check:packed-install && changeset publish",
    "check:exports": "turbo run check:exports",
    "prepare": "husky",
    "pre-commit": "lint-staged && pnpm run typecheck && pnpm run lint:spell",
    "pre-push": "pnpm install --frozen-lockfile && pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test:coverage && pnpm run lint:knip && pnpm run check:exports",
    "commit": "commitprompt"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@santi020k/commitprompt": "catalog:",
    "@santi020k/eslint-config-astro": "catalog:",
    "@santi020k/eslint-config-basic": "catalog:",
    "@santi020k/eslint-config-extensions": "catalog:",
    "@santi020k/eslint-config-formats": "catalog:",
    "@santi020k/eslint-config-libraries": "catalog:",
    "@santi020k/eslint-config-testing": "catalog:",
    "@santi020k/eslint-config-tools": "catalog:",
    "@types/node": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,astro}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ]
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "packageManager": "pnpm@10.34.3"
}
